{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "isolatedModules": true, "noEmit": true, "strict": true,
    "skipLibCheck": true, "noUnusedLocals": false
  },
  "include": ["src"]
}
