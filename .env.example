# Copy to .env for local use. Keep .env and database credentials out of Git.
# npm start, npm run db:check and npm run db:import load .env with Node 24.
# Existing shell/hosting environment variables take precedence.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
COOKIE_SECURE=0

# Local default: accounts live in DATA_DIR/accounts.json.
# For Neon, paste its PostgreSQL connection string here and set DATABASE_REQUIRED=1.
# Keep the TLS options supplied by Neon. Never use a VITE_ prefix for this secret.
DATABASE_URL=
DATABASE_REQUIRED=0
DATA_DIR=./data

# Public build settings for the complete game and same-origin API/WebSocket service.
# Render supplies production HOST/COOKIE_SECURE/DATABASE_REQUIRED in render.yaml.
VITE_BASE_PATH=/
VITE_STATIC_HOST=false
